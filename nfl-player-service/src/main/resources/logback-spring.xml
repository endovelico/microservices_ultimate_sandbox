<configuration>

    <!-- =========================
         SERVICE CONTEXT
    ========================== -->
    <springProperty name="SERVICE_NAME" source="spring.application.name"/>

    <!-- =========================
         CONSOLE APPENDER (human readable dev logs)
    ========================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} | %-5level | ${SERVICE_NAME} | %logger{36} | %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- =========================
         STRUCTURED LOGSTASH APPENDER (JSON)
    ========================== -->
    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">

        <!-- Logstash container from docker-compose -->
        <destination>logstash:5000</destination>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">

            <!-- Global fields added to every log -->
            <customFields>
                {
                "service":"${SERVICE_NAME}",
                "env":"dev"
                }
            </customFields>

            <!-- Include useful structured fields -->
            <includeMdc>true</includeMdc>
            <includeContext>true</includeContext>

        </encoder>
    </appender>

    <!-- =========================
         ROOT LOGGER
    ========================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOGSTASH"/>
    </root>

</configuration>